# Отдельный релизный ключ (необязателен): без него APK подписывает ключ проекта private/signing/debug.keystore.
# Скопируйте файл в private/keystore.properties (в корне проекта) и заполните реальными значениями.
# Папка private/ не коммитится (см. .gitignore). Путь storeFile — относительно папки private/.
#
# Создание ключа:
#   keytool -genkeypair -v -keystore efir-release.jks -alias efir \
#     -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=signing/efir-release.jks
storePassword=CHANGE_ME
keyAlias=efir
keyPassword=CHANGE_ME
